APP_KEY=                    # Run: php artisan key:generate
APP_DEBUG=false             # Never true in production
APP_URL=http://localhost

DB_CONNECTION=mysql         -
DB_HOST=mysql
DB_DATABASE=movie_booking
DB_USERNAME=laravel
DB_PASSWORD=secret

# Razorpay — get from dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay — get from dashboard.razorpay.com → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# TMDB — get from themoviedb.org → Settings → API
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

MAIL_MAILER=log             # Change to 'resend' or 'smtp' in production
